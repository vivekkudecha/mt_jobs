        {
          "name": "Create Tenant Alpha (Active)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Tenant created with valid ID\", function () {",
                  "    pm.expect(jsonData.id).to.be.a('string');",
                  "    pm.expect(jsonData.name).to.include('Tenant Alpha');",
                  "    pm.expect(jsonData.max_concurrent_jobs).to.eql(3);",
                  "    pm.collectionVariables.set(\"tenantId\", jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tenant Alpha - {{$randomUUID}}\",\n  \"max_concurrent_jobs\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tenants/",
